# Copy to .env.local (Next.js) and fill in. Never commit real values.

# Google Gemini (required)
GEMINI_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# PostgreSQL (required), e.g. postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=

# Translation service (required). Local FastAPI default shown.
MODEL_SERVICE_URL=http://localhost:8000
# Optional dedicated Spaces. If unset, MODEL_SERVICE_URL is used.
ASR_SERVICE_URL=
TTS_SERVICE_URL=
# Optional Playwright automation service. If unset, a local in-process run is used (dev only).
AUTOMATION_SERVICE_URL=

# Public URL of this deployment (the bot fetches receipt PDFs from it)
DEMO_BASE_URL=http://localhost:3000

# Telegram bot token from @BotFather (optional)
TELEGRAM_TOKEN=
