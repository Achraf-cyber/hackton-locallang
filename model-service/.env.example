# Copy to .env. Read by app/deps.py (Settings).

# "old" = facebook/nllb + MMS, "goaicorp" = GO AI Corp models (CC-BY-NC 4.0, non-commercial)
MODEL_STACK=old
# local | hf_api | omnilingual | omnilingual_ctc | omnilingual_llm
ASR_BACKEND=local
# mms | omnivoice
TTS_BACKEND_DYU=mms
# Hugging Face token (needed for gated GO AI models)
HF_TOKEN=
# JSON list of allowed CORS origins
ALLOWED_ORIGINS=["*"]
